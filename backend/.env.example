# ============================================================
# Variables de entorno requeridas — copia este archivo a .env
# y rellena los valores. NUNCA subas .env a git.
# ============================================================

# Gmail para envío de correos (usa contraseña de aplicación, no tu contraseña normal)
GMAIL_USER=tucorreo@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx

# URL del frontend en producción (para links en correos)
FRONTEND_URL=https://tu-dominio.vercel.app

# Secreto para firmar JWT (genera uno aleatorio con: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log")
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# PostgreSQL / Supabase
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/database

# ----------------------------------------------------------------
# Contraseñas de seed — SOLO se usan la primera vez que la base de
# datos está vacía (INSERT ... ON CONFLICT DO NOTHING).
# Si SUPERADMIN_SEED_PASSWORD está definido, también se aplica al
# superadmin en cada arranque (útil para restablecer acceso).
# Deja vacío para usar los fallbacks genéricos de desarrollo.
# ----------------------------------------------------------------
SUPERADMIN_SEED_PASSWORD=
DIRECTOR_SEED_PASSWORD=
COORD_SEED_PASSWORD=
PROF_SEED_PASSWORD=
ALUMNO_SEED_PASSWORD=
VENTAS_SEED_PASSWORD=
